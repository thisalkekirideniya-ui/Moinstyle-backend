# Copy this file to .env and fill it in. Never commit .env.

PORT=4000

# Supabase (admin data). Project Settings > Data API (URL) and > API Keys (secret key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Cloudinary (photo uploads). Settings > API Keys > "API environment variable".
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=moins-style

# Addresses of the website and admin panel when they are hosted elsewhere (comma-separated).
# Not needed in development: the Vite dev servers forward /api to this server.
CORS_ORIGINS=https://moinstyle.lk,https://admin.moinstyle.lk

# Signs sign-in cookies. Set a long random value in production so sign-ins survive restarts.
SESSION_SECRET=

# Strict (default) when the admin panel and API share a domain (admin.x.lk / api.x.lk).
# None when they are on different sites (e.g. vercel.app and onrender.com); needs HTTPS.
COOKIE_SAMESITE=Strict

# Set to 1 behind a hosting platform or reverse proxy, so HTTPS is detected.
TRUST_PROXY=

# Password for the very first admin account (only used when there are no users yet).
ADMIN_PASSWORD=
